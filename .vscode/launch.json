{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Akwaba Ivoire – dev (local backend over USB: adb reverse tcp:8000 tcp:8000)",
      "request": "launch",
      "type": "dart",
      "args": ["--flavor", "dev", "--dart-define-from-file=config/dev.json"]
    },
    {
      "name": "Akwaba Ivoire – dev, bypass login",
      "request": "launch",
      "type": "dart",
      "args": ["--flavor", "dev", "--dart-define-from-file=config/dev.json", "--dart-define=DEV_AUTO_LOGIN=true"]
    },
    {
      "name": "Akwaba Ivoire – dev, demo data (no backend)",
      "request": "launch",
      "type": "dart",
      "args": ["--flavor", "dev", "--dart-define=APP_FLAVOR=dev"]
    },
    {
      "name": "Akwaba Ivoire – prod (release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": ["--flavor", "prod", "--dart-define-from-file=config/prod.json"]
    }
  ]
}
